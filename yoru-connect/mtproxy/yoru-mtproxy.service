[Unit]
Description=Yoru Connect MTProxy
Wants=network-online.target
After=network-online.target

[Service]
DynamicUser=yes
LoadCredential=client-secrets:/etc/yoru-mtproxy/client-secrets
Environment=YORU_MTPROXY_PORT=443 YORU_MTPROXY_STATS_PORT=2399 YORU_MTPROXY_NAT_ARGS=
EnvironmentFile=-/etc/yoru-mtproxy/service.env
ExecStart=/usr/bin/python3 /opt/yoru-mtproxy/proxyctl.py run --engine /opt/yoru-mtproxy/mtproto-proxy --key-file %d/client-secrets --port ${YORU_MTPROXY_PORT} --stats-port ${YORU_MTPROXY_STATS_PORT} $YORU_MTPROXY_NAT_ARGS
Restart=on-failure
RestartSec=5s
LimitNOFILE=65536
UMask=0077
NoNewPrivileges=yes
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
PrivateTmp=yes
PrivateDevices=yes
ProtectHome=yes
ProtectSystem=strict
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK

[Install]
WantedBy=multi-user.target
