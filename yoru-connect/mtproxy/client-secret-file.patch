 server_functions_t mtproto_front_functions;
+/* Read the transport secrets without putting them in the process arguments. */
+static void load_client_secrets (const char *path) {
+  FILE *file = fopen (path, "r");
+  if (!file) {
+    kprintf ("Cannot read client secret file: %m\n");
+    exit (2);
+  }
+
+  char *line = NULL;
+  size_t capacity = 0;
+  ssize_t length;
+  int valid = 1;
+  int previous_count = secret_count;
+  while ((length = getline (&line, &capacity, file)) >= 0) {
+    if (length > 0 && line[length - 1] == '\n') {
+      length--;
+    }
+    if (length != 32 || secret_count >= 16) {
+      valid = 0;
+      break;
+    }
+
+    unsigned char secret[16] = {0};
+    for (int i = 0; i < 32; i++) {
+      unsigned char digit = line[i];
+      if (!isxdigit (digit)) {
+        valid = 0;
+        break;
+      }
+      secret[i / 2] = 16 * secret[i / 2] + (digit <= '9' ? digit - '0' : tolower (digit) - 'a' + 10);
+    }
+    if (valid) {
+      tcp_rpcs_set_ext_secret (secret);
+      secret_count++;
+    }
+    OPENSSL_cleanse (secret, sizeof (secret));
+    if (!valid) {
+      break;
+    }
+  }
+  valid = valid && !ferror (file) && feof (file) && secret_count > previous_count;
+  fclose (file);
+  if (line) {
+    OPENSSL_cleanse (line, capacity);
+    free (line);
+  }
+  if (!valid) {
+    kprintf ("Client secret file must contain 1 to 16 lines of 32 hex digits\n");
+    exit (2);
+  }
+}
